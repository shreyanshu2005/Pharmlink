PORT=4000
CURRENCY=INR

# Database (local: mongodb://localhost:27017/pharmlink  |  Atlas: mongodb+srv://user:pass@cluster/pharmlink)
MONGODB_URI=

# Any long random string (e.g. run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=

# Admin panel login
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Cloudinary (doctor/user images)
CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_SECRET_KEY=

# Razorpay (payments) - use TEST keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Google OAuth + Calendar/Meet
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_REFRESH_TOKEN=      # generate with: node scripts/getRefreshToken.js

# Gmail used to send emails (use an App Password, not your normal password)
EMAIL_USER=
EMAIL_PASSWORD=
