# Used by docker-compose.yml for the frontend/admin build (copy to .env in the project root).
# These are public values baked into the browser bundle, so never put secrets here.
VITE_BACKEND_URL=http://localhost:4000
VITE_CHATBOT_URL=http://localhost:5000
VITE_RAZORPAY_KEY_ID=your_razorpay_key_id
VITE_GOOGLE_CLIENT_ID=your_google_client_id
VITE_CURRENCY=₹
