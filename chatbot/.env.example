# Required
HF_TOKEN=
PINECONE_API_KEY=
PINECONE_INDEX_NAME=medical-chatbot-index

# Pinecone serverless location (PINECONE_ENVIRONMENT=gcp-starter is retired)
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# Models (change LLM_MODEL if your HF account can't serve it)
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
LLM_MODEL=mistralai/Mistral-7B-Instruct-v0.3

# Retrieval
TOP_K=4
MIN_SCORE=0.30

# Security
ALLOWED_ORIGINS=http://localhost:5173,https://pharmlink-healthcareservices.vercel.app
RATE_LIMIT_PER_MIN=20
PORT=5000
